# Copy to .env and fill in your API key:  cp .env.skel .env
#
# Hansestack API credentials — required.
# Get a key at https://portal.hansestack.de
LEAKCHECK_API_KEY=

# Application
LEAKCHECK_APP_ENVIRONMENT=development
LEAKCHECK_LOG_LEVEL=debug
LEAKCHECK_SERVICE_NAME=leakcheck-demo
LEAKCHECK_SERVE_PORT=8080

# Leak-check client tuning.
# Timeout accepts any Go duration string (500ms, 1s, ...).
LEAKCHECK_TIMEOUT=500ms

# Fail-open (false) is the correct setting for interactive auth flows: a leak
# check that cannot complete must never block a signup or login. Set to true
# only for batch jobs, CI checks or admin tooling.
LEAKCHECK_FAIL_CLOSE=false

# Timezone
TZ=Europe/Berlin
